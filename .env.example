# Copied at build time. Required for production (e.g. Vercel): set in
# Project Settings → Environment Variables, then redeploy.
# Example if the API is on Render:
# VITE_API_BASE_URL=https://climavise.onrender.com

VITE_API_BASE_URL=http://localhost:8000

# Optional: prediction fetch timeout (ms)
# VITE_PREDICT_TIMEOUT_MS=180000
